<?xml version="1.0" encoding="utf-8"?>
<!-- OpenXWA for standalone OpenXR headsets (Meta Quest, Pico, Steam Frame). Values in @...@ are filled in by build_apk.py. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="@PACKAGE@"
    android:versionCode="@VERSION_CODE@"
    android:versionName="@VERSION_NAME@"
    android:installLocation="auto">

    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="32" />

    <!-- Headset only: 6DoF head tracking and Vulkan 1.1 -->
    <uses-feature android:name="android.hardware.vr.headtracking" android:required="true" android:version="1" />
    <uses-feature android:name="android.hardware.vulkan.version" android:required="true" android:version="0x401000" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- Quest: the headset's own controller models (XR_FB_render_model). -->
    <uses-feature android:name="com.oculus.feature.RENDER_MODEL" android:required="false" />

    <!-- OpenXR loader / runtime broker (Khronos loader for Android) -->
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR" />
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR_SYSTEM" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Voice commands (push-to-talk on the thumb rests), recognized on the headset -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Multiplayer (UDP); the multicast lock lets the headset hear LAN game discovery broadcasts -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="com.oculus.permission.RENDER_MODEL" />
    <queries>
        <provider android:authorities="org.khronos.openxr.runtime_broker;org.khronos.openxr.system_runtime_broker" />
        <intent>
            <action android:name="org.khronos.openxr.OpenXRRuntimeService" />
        </intent>
        <intent>
            <action android:name="org.khronos.openxr.OpenXRApiLayerService" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:hasCode="true"
        android:extractNativeLibs="true"
        android:isGame="true"
        android:appCategory="game"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">

        <meta-data android:name="com.oculus.supportedDevices" android:value="quest2|questpro|quest3|quest3s" />
        <meta-data android:name="com.oculus.handtracking.frequency" android:value="HIGH" />
        <!-- Meta Quest OS loading splash (assets/vr_splash.png, not in the repo) -->
        <meta-data android:name="com.oculus.ossplash" android:value="true" />
        <!-- Other headsets, same APK (the Khronos loader finds each runtime):
             Pico (Neo 3, 4, 4 Ultra) starts it as a VR app, not a 2D panel;
             Play For Dream likewise. Steam Frame needs nothing beyond the
             MAIN/LAUNCHER filter on the activity itself. -->
        <meta-data android:name="pvr.app.type" android:value="vr" />
        <meta-data android:name="com.yvr.intent.category.VR" android:value="vr_only" />
        <!-- SDL: keep running when the headset's system UI takes focus -->
        <meta-data android:name="SDL_ENV.SDL_ANDROID_BLOCK_ON_PAUSE" android:value="0" />

        <activity
            android:name="org.openxwa.quest.OpenXwaActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:resizeableActivity="false"
            android:excludeFromRecents="false"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|uiMode">
            <meta-data android:name="com.oculus.vr.focusaware" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="com.oculus.intent.category.VR" />
                <category android:name="org.khronos.openxr.intent.category.IMMERSIVE_HMD" />
            </intent-filter>
        </activity>

        <!-- For the PC launcher over USB (adb only, checked in the code): makes
             the app's folders and unpacks the game files as the app, so they
             belong to it. See SetupProvider.java. -->
        <provider
            android:name="org.openxwa.quest.SetupProvider"
            android:authorities="org.openxwa.quest.setup"
            android:exported="true" />
    </application>
</manifest>
